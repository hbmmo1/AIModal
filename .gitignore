# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / PyInstaller build outputs
dist/
build/
*.egg-info/
*.egg

# Environment variables & secrets
.env
.env.local
.env.*.local

# Local database & state (SQLite containing user keys)
config/*.db
config/*.db-journal
*.db
*.sqlite3

# Logs & temp files
*.log
error_log.txt
output/*
!output/.gitkeep
screenshots/*
!screenshots/.gitkeep

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Archive packages
*.zip
*.tar.gz
*.rar
